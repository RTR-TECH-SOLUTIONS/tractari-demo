---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Hero from "../components/Hero.astro";
import BandaIncredere from "../components/BandaIncredere.astro";
import Servicii from "../components/Servicii.astro";
import Tarife from "../components/Tarife.astro";
import Calculator from "../components/Calculator.astro";
import Etape from "../components/Etape.astro";
import Flota from "../components/Flota.astro";
import Despre from "../components/Despre.astro";
import Zone from "../components/Zone.astro";
import Recenzii from "../components/Recenzii.astro";
import Intrebari from "../components/Intrebari.astro";
import Contact from "../components/Contact.astro";
import Footer from "../components/Footer.astro";
import BaraMobil from "../components/BaraMobil.astro";
---

<Layout>
  <Header />
  <main id="continut">
    <Hero />
    <BandaIncredere />
    <Servicii />
    <Tarife />
    <Calculator />
    <Etape />
    <Flota />
    <Despre />
    <Zone />
    <Recenzii />
    <Intrebari />
    <Contact />
  </main>
  <Footer />
  <BaraMobil />
</Layout>
