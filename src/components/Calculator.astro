---
import { categoriiVehicul, extraCalculator, firma } from "../data";
import AntetSectiune from "./AntetSectiune.astro";

const config = {
  categorii: categoriiVehicul,
  extra: extraCalculator,
  whatsapp: firma.whatsapp,
};
---

<section id="calculator" class="scroll-mt-24 bg-ink-950 py-20 sm:py-28">
  <div class="container-site">
    <AntetSectiune
      clar
      titlu="Calculator"
      accent="de tarif"
      text="Alegeți mașina și locul unde se află. Vă arătăm estimarea pe loc, cu tot cu detaliul sumelor — aceleași cifre pe care le folosește și dispecerul."
    />

    <div
      class="apare mt-14 grid grid-cols-1 overflow-hidden rounded-card border border-ink-800 bg-ink-900 lg:grid-cols-[1fr_22rem]"
    >
      <!-- Formular -->
      <form id="calc" class="flex flex-col gap-8 p-6 sm:p-9" novalidate>
        <!-- 1. Vehicul -->
        <fieldset>
          <legend
            class="font-display text-[0.8rem] font-bold tracking-[0.1em] text-white/45 uppercase"
          >
            <span class="text-rosu-500 cifre">01</span> &nbsp;Ce vehicul aveți
          </legend>
          <div class="mt-4 grid grid-cols-1 gap-2.5 sm:grid-cols-2">
            {
              categoriiVehicul.map((c, i) => (
                <label
                  class="relative flex cursor-pointer flex-col rounded-xl border border-ink-700 bg-ink-950/50 px-4 py-3.5 transition-colors duration-150 hover:border-ink-500 has-checked:border-rosu-500 has-checked:bg-rosu-500/10"
                >
                  <input
                    type="radio"
                    name="categorie"
                    value={c.id}
                    checked={i === 1}
                    class="sr-only"
                  />
                  <span class="text-[0.98rem] font-semibold text-white cifre">
                    {c.eticheta}
                  </span>
                  <span class="mt-0.5 text-[0.82rem] text-white/45">
                    {c.exemplu}
                  </span>
                </label>
              ))
            }
          </div>
        </fieldset>

        <!-- 2. Unde -->
        <fieldset>
          <legend
            class="font-display text-[0.8rem] font-bold tracking-[0.1em] text-white/45 uppercase"
          >
            <span class="text-rosu-500 cifre">02</span> &nbsp;Unde se află mașina
          </legend>
          <div class="mt-4 grid grid-cols-2 gap-2.5">
            <label
              class="flex cursor-pointer items-center justify-center rounded-xl border border-ink-700 bg-ink-950/50 px-4 py-3.5 text-center text-[0.95rem] font-semibold text-white transition-colors duration-150 hover:border-ink-500 has-checked:border-rosu-500 has-checked:bg-rosu-500/10"
            >
              <input type="radio" name="loc" value="oras" checked class="sr-only" />
              În București
            </label>
            <label
              class="flex cursor-pointer items-center justify-center rounded-xl border border-ink-700 bg-ink-950/50 px-4 py-3.5 text-center text-[0.95rem] font-semibold text-white transition-colors duration-150 hover:border-ink-500 has-checked:border-rosu-500 has-checked:bg-rosu-500/10"
            >
              <input type="radio" name="loc" value="afara" class="sr-only" />
              În afara orașului
            </label>
          </div>

          <div id="zona-km" hidden class="mt-5">
            <div class="flex items-baseline justify-between">
              <label for="km" class="text-[0.92rem] text-white/70">
                Distanța până la destinație
              </label>
              <output
                id="km-valoare"
                for="km"
                class="font-display text-[1.6rem] leading-none font-bold text-[color:var(--color-galben-400)] cifre"
                >40 km</output
              >
            </div>
            <input
              type="range"
              id="km"
              name="km"
              min="10"
              max="300"
              step="5"
              value="40"
              class="mt-3 h-1.5 w-full cursor-pointer appearance-none rounded-full bg-ink-700 accent-[color:var(--color-rosu-500)]"
            />
            <div
              class="mt-1.5 flex justify-between text-[0.75rem] text-white/50 cifre"
            >
              <span>10 km</span>
              <span>300 km</span>
            </div>
          </div>
        </fieldset>

        <!-- 3. Situatii speciale -->
        <fieldset>
          <legend
            class="font-display text-[0.8rem] font-bold tracking-[0.1em] text-white/45 uppercase"
          >
            <span class="text-rosu-500 cifre">03</span> &nbsp;Situații speciale
            <span class="ml-1 font-sans text-[0.72rem] font-normal tracking-normal normal-case"
              >(dacă e cazul)</span
            >
          </legend>
          <div class="mt-4 flex flex-col gap-2.5">
            {
              extraCalculator.map((e) => (
                <label class="flex cursor-pointer items-center gap-3.5 rounded-xl border border-ink-700 bg-ink-950/50 px-4 py-3 transition-colors duration-150 hover:border-ink-500 has-checked:border-rosu-500 has-checked:bg-rosu-500/10">
                  <input
                    type="checkbox"
                    name="extra"
                    value={e.id}
                    class="grid size-5 shrink-0 appearance-none place-content-center rounded-[5px] border border-ink-500 bg-transparent bg-[length:0.7rem] bg-center bg-no-repeat transition-colors duration-150 checked:border-rosu-500 checked:bg-rosu-500 checked:bg-[url('data:image/svg+xml;charset=utf-8,%3Csvg%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%20viewBox%3D%220%200%2016%2016%22%20fill%3D%22none%22%20stroke%3D%22%23fff%22%20stroke-width%3D%223%22%20stroke-linecap%3D%22round%22%20stroke-linejoin%3D%22round%22%3E%3Cpath%20d%3D%22M3%208.5l3.5%203.5L13%204%22%2F%3E%3C%2Fsvg%3E')]"
                  />
                  <span class="flex-1 text-[0.93rem] text-white/85">
                    {e.eticheta}
                  </span>
                  <span class="shrink-0 text-[0.85rem] font-semibold text-white/45 cifre">
                    + {e.pret} lei
                  </span>
                </label>
              ))
            }
          </div>
        </fieldset>
      </form>

      <!-- Rezultat -->
      <aside
        class="flex flex-col border-t border-ink-800 bg-ink-950 p-6 sm:p-9 lg:border-t-0 lg:border-l"
      >
        <p
          class="font-display text-[0.8rem] font-bold tracking-[0.1em] text-white/45 uppercase"
        >
          Estimare
        </p>

        <p class="mt-4 flex items-baseline gap-2">
          <span
            id="total"
            class="font-display text-[3.4rem] leading-none font-bold text-white cifre">130</span
          >
          <span class="text-[1.1rem] font-semibold text-white/50">lei</span>
        </p>

        <dl
          id="detaliu"
          class="mt-6 flex flex-col divide-y divide-ink-800 border-y border-ink-800"
        >
        </dl>

        <p class="mt-5 text-[0.82rem] leading-relaxed text-white/50">
          Estimare orientativă, cu TVA inclus. Prețul ferm vi-l confirmă
          dispecerul la telefon, după ce aude situația exactă.
        </p>

        <div class="mt-8 rounded-xl border border-ink-800 px-5 py-4">
          <h3
            class="text-[0.72rem] font-semibold tracking-[0.06em] text-white/50 uppercase"
          >
            Prețul include
          </h3>
          <ul class="mt-3 flex flex-col gap-2">
            {
              [
                "Deplasarea dus-întors a platformei",
                "Încărcarea și fixarea vehiculului",
                "Asigurarea pe durata transportului",
              ].map((x) => (
                <li class="flex gap-2.5 text-[0.85rem] leading-snug text-white/60">
                  <span
                    class="mt-[0.55em] size-1 shrink-0 rounded-full bg-[color:var(--color-galben-400)]"
                    aria-hidden="true"
                  />
                  {x}
                </li>
              ))
            }
          </ul>
        </div>

        <div class="mt-auto flex flex-col gap-2.5 pt-7">
          <a
            href={firma.telefonHref}
            class="inline-flex items-center justify-center gap-2.5 rounded-xl bg-rosu-500 px-5 py-3.5 font-display text-[1.2rem] font-bold tracking-tight text-white uppercase transition-colors duration-200 hover:bg-rosu-600"
          >
            <span class="cifre">{firma.telefon}</span>
          </a>
          <a
            id="calc-whatsapp"
            href={`https://wa.me/${firma.whatsapp}`}
            target="_blank"
            rel="noopener"
            class="inline-flex items-center justify-center gap-2.5 rounded-xl border border-ink-700 px-5 py-3.5 font-semibold text-white transition-colors duration-200 hover:border-ink-500 hover:bg-white/5"
          >
            <svg class="size-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path
                d="M17.47 14.38c-.3-.15-1.75-.86-2.02-.96-.27-.1-.47-.15-.67.15-.2.3-.77.96-.94 1.16-.17.2-.35.22-.65.07-.3-.15-1.25-.46-2.38-1.47-.88-.78-1.48-1.75-1.65-2.05-.17-.3-.02-.46.13-.61.14-.13.3-.35.45-.52.15-.17.2-.3.3-.5.1-.2.05-.37-.02-.52-.08-.15-.67-1.6-.92-2.2-.24-.58-.49-.5-.67-.5h-.57c-.2 0-.52.07-.8.37-.27.3-1.04 1.02-1.04 2.48s1.07 2.88 1.22 3.08c.15.2 2.1 3.2 5.08 4.49.71.3 1.26.49 1.69.63.71.22 1.36.19 1.87.12.57-.09 1.75-.72 2-1.41.25-.69.25-1.28.17-1.41-.07-.13-.27-.2-.57-.35ZM12.04 21.5h-.01a9.4 9.4 0 0 1-4.79-1.31l-.34-.2-3.56.93.95-3.47-.22-.36a9.38 9.38 0 0 1-1.44-5.01c0-5.18 4.22-9.4 9.42-9.4a9.34 9.34 0 0 1 6.65 2.76 9.32 9.32 0 0 1 2.75 6.65c0 5.18-4.22 9.41-9.41 9.41ZM20.5 3.49A11.78 11.78 0 0 0 12.04 0C5.5 0 .18 5.32.17 11.86c0 2.09.55 4.13 1.59 5.93L.07 24l6.35-1.66a11.85 11.85 0 0 0 5.62 1.43h.01c6.54 0 11.86-5.32 11.87-11.86a11.8 11.8 0 0 0-3.42-8.42Z"
              ></path>
            </svg>
            Trimite pe WhatsApp
          </a>
        </div>
      </aside>
    </div>
  </div>
</section>

<script is:inline define:vars={{ config }}>
  (() => {
    const form = document.getElementById("calc");
    if (!form) return;

    const elTotal = document.getElementById("total");
    const elDetaliu = document.getElementById("detaliu");
    const zonaKm = document.getElementById("zona-km");
    const inputKm = document.getElementById("km");
    const elKmValoare = document.getElementById("km-valoare");
    const linkWhatsapp = document.getElementById("calc-whatsapp");

    const lei = (n) =>
      new Intl.NumberFormat("ro-RO", { maximumFractionDigits: 0 }).format(n);

    const rand = (eticheta, valoare) => {
      const d = document.createElement("div");
      d.className = "flex items-baseline justify-between gap-4 py-2.5";
      const dt = document.createElement("dt");
      dt.className = "text-[0.88rem] text-white/60";
      dt.textContent = eticheta;
      const dd = document.createElement("dd");
      dd.className =
        "shrink-0 text-[0.9rem] font-semibold text-white tabular-nums";
      dd.textContent = valoare;
      d.append(dt, dd);
      return d;
    };

    const calculeaza = () => {
      const date = new FormData(form);
      const categorie =
        config.categorii.find((c) => c.id === date.get("categorie")) ??
        config.categorii[1];
      const inAfara = date.get("loc") === "afara";
      const km = Number(date.get("km") ?? 40);
      const alese = date.getAll("extra");

      zonaKm.hidden = !inAfara;
      elKmValoare.textContent = `${km} km`;

      const linii = [];
      let total = 0;

      if (inAfara) {
        const transport = Math.round(km * categorie.km);
        total += transport;
        linii.push([
          `Transport ${km} km × ${categorie.km.toLocaleString("ro-RO", { minimumFractionDigits: 2 })} lei`,
          `${lei(transport)} lei`,
        ]);
      } else {
        total += categorie.oras;
        linii.push(["Tractare în București, tarif fix", `${lei(categorie.oras)} lei`]);
      }

      for (const id of alese) {
        const e = config.extra.find((x) => x.id === id);
        if (!e) continue;
        total += e.pret;
        linii.push([e.eticheta, `+ ${lei(e.pret)} lei`]);
      }

      elTotal.textContent = lei(total);
      elDetaliu.replaceChildren(...linii.map(([a, b]) => rand(a, b)));

      const mesaj =
        `Bună ziua! Am nevoie de tractare.\n` +
        `Vehicul: ${categorie.eticheta} (${categorie.exemplu})\n` +
        `Locație: ${inAfara ? `în afara Bucureștiului, aproximativ ${km} km` : "în București"}\n` +
        (alese.length
          ? `Situație: ${alese
              .map((id) => config.extra.find((x) => x.id === id)?.eticheta)
              .filter(Boolean)
              .join("; ")}\n`
          : "") +
        `Estimare de pe site: ${lei(total)} lei.`;

      linkWhatsapp.href = `https://wa.me/${config.whatsapp}?text=${encodeURIComponent(mesaj)}`;
    };

    form.addEventListener("change", calculeaza);
    inputKm.addEventListener("input", calculeaza);
    calculeaza();
  })();
</script>
