---
import { zone } from "../data";
import AntetSectiune from "./AntetSectiune.astro";

const grupuri = [
  { id: "bucuresti", titlu: "București, pe sectoare" },
  { id: "ilfov", titlu: "Ilfov" },
  { id: "drumuri", titlu: "Autostrăzi și drumuri naționale" },
] as const;

const inele = [
  { r: 130, eticheta: "Autostrăzi și DN", timp: "30–50", umplere: "#f6f8fa" },
  { r: 96, eticheta: "Ilfov", timp: "25–45", umplere: "#eef1f4" },
  { r: 58, eticheta: "București", timp: "15–35", umplere: "#e3e8ed" },
];
---

<section id="zone" class="scroll-mt-24 bg-white py-20 sm:py-28">
  <div class="container-site">
    <AntetSectiune
      titlu="Unde"
      accent="ajungem"
      text="Timpii de mai jos sunt medii reale de deplasare, măsurate în trafic normal. La ore de vârf sau pe ploaie, dispecerul vă spune la telefon cât durează efectiv."
    />

    <div class="mt-14 grid grid-cols-1 items-start gap-10 lg:grid-cols-[minmax(0,22rem)_1fr] lg:gap-16">
      <!-- Schema de acoperire -->
      <div class="apare mx-auto w-full max-w-[22rem]">
        <svg
          viewBox="0 0 300 300"
          class="w-full"
          role="img"
          aria-label="Schemă cu razele de acoperire: București 15-35 de minute, Ilfov 25-45 de minute, autostrăzi și drumuri naționale 30-50 de minute"
        >
          {
            inele.map((inel) => (
              <circle
                cx="150"
                cy="150"
                r={inel.r}
                fill={inel.umplere}
                stroke="var(--color-ink-300)"
                stroke-width="1"
                stroke-dasharray="4 5"
              />
            ))
          }

          <!-- axe discrete, ca pe o harta de dispecerat -->
          <line
            x1="150"
            y1="6"
            x2="150"
            y2="294"
            stroke="var(--color-ink-300)"
            stroke-width="1"
            stroke-dasharray="2 6"></line>
          <line
            x1="6"
            y1="150"
            x2="294"
            y2="150"
            stroke="var(--color-ink-300)"
            stroke-width="1"
            stroke-dasharray="2 6"></line>

          <circle cx="150" cy="150" r="5.5" fill="var(--color-rosu-500)"></circle>
          <circle
            cx="150"
            cy="150"
            r="12"
            fill="none"
            stroke="var(--color-rosu-500)"
            stroke-width="1.5"
            opacity="0.4"></circle>
        </svg>

        <dl class="mt-6 flex flex-col divide-y divide-ink-100 border-y border-ink-100">
          {
            inele
              .slice()
              .reverse()
              .map((inel) => (
                <div class="flex items-center gap-3 py-3">
                  <span
                    class="size-3.5 shrink-0 rounded-[3px] border border-ink-300"
                    style={`background:${inel.umplere}`}
                    aria-hidden="true"
                  />
                  <dt class="flex-1 text-[0.95rem] font-medium text-ink-950">
                    {inel.eticheta}
                  </dt>
                  <dd class="shrink-0 font-display text-[1.05rem] font-bold text-ink-950 cifre">
                    {inel.timp}
                    <span class="ml-1 text-[0.75rem] font-semibold text-ink-500">
                      min
                    </span>
                  </dd>
                </div>
              ))
          }
        </dl>

        <p class="mt-3 text-center text-[0.82rem] text-ink-500">
          Bază: Șos. Fundeni, Sector 2
        </p>
      </div>

      <!-- Tabel zone -->
      <div class="apare w-full" data-index="1">
        {
          grupuri.map((g) => (
            <div class="mb-8 last:mb-0">
              <h3 class="text-[0.78rem] font-semibold tracking-[0.06em] text-ink-500 uppercase">
                {g.titlu}
              </h3>
              <dl class="mt-3 flex flex-col divide-y divide-ink-100 border-y border-ink-100">
                {zone
                  .filter((z) => z.grup === g.id)
                  .map((z) => (
                    <div class="flex flex-wrap items-baseline gap-x-4 gap-y-1 py-3.5">
                      <dt class="min-w-[7.5rem] font-semibold text-ink-950">
                        {z.nume}
                      </dt>
                      <dd class="flex-1 text-[0.9rem] text-ink-500">
                        {z.detaliu}
                      </dd>
                      <dd class="shrink-0 font-display text-[1.15rem] font-bold text-ink-950 cifre">
                        {z.timp}
                        <span class="ml-1 text-[0.78rem] font-semibold text-ink-500">
                          min
                        </span>
                      </dd>
                    </div>
                  ))}
              </dl>
            </div>
          ))
        }

        <p class="mt-6 text-[0.9rem] text-ink-500">
          Pentru distanțe mai mari sau transport internațional, sunați la
          dispecerat și stabilim traseul și tariful înainte de plecare.
        </p>
      </div>
    </div>
  </div>
</section>
