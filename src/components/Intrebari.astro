---
import { intrebari, firma } from "../data";
import AntetSectiune from "./AntetSectiune.astro";
---

<section class="bg-white py-20 sm:py-28">
  <div class="container-site">
    <div class="grid grid-cols-1 gap-12 lg:grid-cols-[minmax(0,20rem)_1fr] lg:gap-16">
      <div class="apare lg:sticky lg:top-[calc(var(--header-h)+2rem)] lg:self-start">
        <AntetSectiune
          aliniereStanga
          titlu="Întrebări"
          accent="frecvente"
          text="Cele mai des puse la telefon, cu răspunsurile pe care le dă și dispecerul."
        />
        <a
          href={firma.telefonHref}
          class="mt-7 inline-flex items-center gap-2.5 rounded-xl bg-ink-950 px-5 py-3.5 font-semibold text-white transition-colors duration-200 hover:bg-ink-800"
        >
          Nu găsiți răspunsul? <span class="text-rosu-500 cifre">{firma.telefon}</span>
        </a>
      </div>

      <div class="apare divide-y divide-ink-100 border-y border-ink-100" data-index="1">
        {
          intrebari.map((q, i) => (
            <details class="group" name="faq" open={i === 0}>
              <summary class="flex cursor-pointer list-none items-start justify-between gap-6 py-5 text-[1.1rem] font-semibold text-ink-950 transition-colors duration-150 hover:text-rosu-500 [&::-webkit-details-marker]:hidden">
                {q.intrebare}
                <span
                  class="relative mt-2 block size-3.5 shrink-0"
                  aria-hidden="true"
                >
                  <span class="absolute top-1/2 left-0 h-0.5 w-full -translate-y-1/2 bg-rosu-500" />
                  <span class="absolute top-0 left-1/2 h-full w-0.5 -translate-x-1/2 bg-rosu-500 transition-transform duration-200 group-open:scale-y-0" />
                </span>
              </summary>
              <p class="pr-10 pb-6 text-[0.98rem] leading-relaxed text-ink-500">
                {q.raspuns}
              </p>
            </details>
          ))
        }
      </div>
    </div>
  </div>
</section>
